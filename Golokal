
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GoLokal - Pesan Layanan</title>
    <link rel="stylesheet" href="style.css">
    <script src="app.js" defer></script>
</head>
<body>

    <header>
        <h1>Go<span>Lokal</span></h1>
        <p>Layanan lokal, lebih mudah!</p>
    </header>

    <main>
        <section class="hero">
            <h2>Mau pergi ke mana hari ini?</h2>
            <p>Pesan ojek atau kurir dengan mudah melalui GoLokal.</p>
        </section>

        <section class="card">
            <h2>Buat Pesanan</h2>

            <form id="orderForm">
                <label for="nama">Nama pelanggan</label>
                <input type="text" id="nama"
                    placeholder="Masukkan nama kamu" required>

                <label for="layanan">Pilih layanan</label>
                <select id="layanan">
                    <option value="Ojek">GoOjek - Rp5.000</option>
                    <option value="Kurir">GoKurir - Rp8.000</option>
                </select>

                <label for="asal">Lokasi penjemputan</label>
                <input type="text" id="asal"
                    placeholder="Contoh: Kampus" required>

                <label for="tujuan">Lokasi tujuan</label>
                <input type="text" id="tujuan"
                    placeholder="Contoh: Perpustakaan" required>

                <button type="submit">Buat Pesanan</button>
            </form>

            <p id="pesan"></p>
        </section>

        <section class="card">
            <h2>Pesanan Saya</h2>
            <div id="daftarPesanan">
                <p>Belum ada pesanan.</p>
            </div>
        </section>
    </main>

    <footer>
        <p>GoLokal | Project Cloud Computing</p>
    </footer>

</body>
</html>

const form = document.getElementById("orderForm");
const pesan = document.getElementById("pesan");
const daftarPesanan = document.getElementById("daftarPesanan");

const API_URL = "http://localhost:8080";

form.addEventListener("submit", async function(event) {
    event.preventDefault();

    const nama = document.getElementById("nama").value;
    const layanan = document.getElementById("layanan").value;
    const asal = document.getElementById("asal").value;
    const tujuan = document.getElementById("tujuan").value;

    try {
        const response = await fetch(`${API_URL}/api/orders`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                nama: nama,
                layanan: layanan,
                asal: asal,
                tujuan: tujuan
            })
        });

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.message);
        }

        pesan.textContent = "Pesanan berhasil dibuat!";

        form.reset();

        tampilkanPesanan();

    } catch (error) {
        console.error(error);
        pesan.textContent = "Gagal membuat pesanan: " + error.message;
    }
});

async function tampilkanPesanan() {
    try {
        const response = await fetch(`${API_URL}/api/orders`);
        const orders = await response.json();

        daftarPesanan.replaceChildren();

        if (orders.length === 0) {
            daftarPesanan.innerHTML = "<p>Belum ada pesanan.</p>";
            return;
        }

        orders.forEach(order => {
            const kartu = document.createElement("div");

            kartu.style.border = "1px solid #ccd8cf";
            kartu.style.padding = "12px";
            kartu.style.marginTop = "12px";
            kartu.style.borderRadius = "8px";

            kartu.innerHTML = `
                <h3>Pesanan #${order.id}</h3>
                <p>${order.nama} | ${order.layanan}</p>
                <p>${order.asal} → ${order.tujuan}</p>
                <p>Estimasi: Rp${order.harga.toLocaleString("id-ID")}</p>
                <p>Status: ${order.status}</p>
            `;

            daftarPesanan.appendChild(kartu);
        });

    } catch (error) {
        console.error(error);
        daftarPesanan.innerHTML =
            "<p>Backend belum terhubung.</p>";
    }
}

// Memuat pesanan saat halaman dibuka
tampilkanPesanan();




